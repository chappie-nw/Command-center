# Copy these into Vercel → Project → Settings → Environment Variables.
# Every one is optional; the dashboard tells you which panel needs which.

# Google Calendar "Secret address in iCal format". One per calendar, comma-separated.
# Optional "Label|" prefix names the calendar.
GCAL_ICS_URLS=Personal|https://calendar.google.com/calendar/ical/.../basic.ics,Work|https://calendar.google.com/calendar/ical/.../basic.ics

# Lock your calendar and to-do data behind a passcode (strongly recommended — the site is public).
DASHBOARD_PASSCODE=pick-something-memorable

# Live IPO calendar. Free key from https://finnhub.io/register (falls back to Nasdaq's public calendar without it).
FINNHUB_API_KEY=

# Sync reminders + committee deadlines across devices. Added automatically when you
# connect "Upstash for Redis" from Vercel → Storage. Without these, data stays on each device.
KV_REST_API_URL=
KV_REST_API_TOKEN=
